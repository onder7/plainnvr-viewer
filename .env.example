# PlainNVR Viewer Environment Variables

# Path to PlainNVR data root (contains nvr.sqlite3 and camera folders)
NVR_VIDEO_ROOT=/mnt/DATA/nv1

# Path to PlainNVR SQLite database
NVR_DB_PATH=/mnt/DATA/nv1/nvr.sqlite3

# Single password for the read-only viewer (change this value)
VIEWER_PASSWORD=senin_sifreni

# Long random secret used to sign JWT sessions
JWT_SECRET=uzun-rastgele-bir-jwt-secret
